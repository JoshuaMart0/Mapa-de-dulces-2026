rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Neighborhood houses: public read for all attendees, write for updates
    match /houses/{houseId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
